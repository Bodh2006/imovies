{
  "name": "imovies",
  "version": "1.0.0",
  "description": "IMovies - Online Movie Ticket Booking Platform (MERN Stack)",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "keywords": [
    "mern",
    "movie-booking",
    "ticket-reservation",
    "seat-locking",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Antigravity AI",
  "license": "ISC",
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1"
  }
}
